# ==============================================================================
# Environment Configuration Template
# Copy this file to .env and supply your credentials:
#   cp .env.example .env
# ==============================================================================

# 1. Google Gemini API Key (Required for AI Extraction & Copilot)
# Get your free API key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Firebase Cloud Firestore (Optional - platform falls back to local storage if absent)
# Option A: Single-line compact JSON (Ideal for Vercel / Cloud deployment)
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}

# Option B: Individual environment variables
# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Option C: Local credentials file path
# FIREBASE_CREDENTIALS_PATH=firebase_credentials.json

# 3. Server Configuration
PORT=5000
